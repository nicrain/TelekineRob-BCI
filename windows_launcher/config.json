{
  "service": {
    "host": "127.0.0.1",
    "port": 8020,
    "allowed_origins": []
  },

  "wsl": {
    "distro": "Ubuntu",
    "repo_path": "/home/robot/TelekineRob-BCI",
    "stop_wsl": true,
    "ready_timeout_sec": 60,
    "ready_poll_sec": 2
  },

  "sync": {
    "tool": "robocopy",
    "src_wsl_root": "\\\\wsl$\\Ubuntu\\home\\robot\\TelekineRob-BCI",
    "dst_root": "C:\\Users\\Robot\\Desktop\\gpype_test\\TelekineRob-BCI",
    "items": [
      { "src": "windows_launcher", "exclude": ["config.json"] },
      { "src": "gtec_bridge", "exclude": [] }
    ],
    "success_exit_codes": [0, 1, 2, 3, 4, 5, 6, 7]
  },

  "web": {
    "url": "http://localhost:5173",
    "backend_cmd": "cd web_gui/backend && source /opt/ros/kilted/setup.bash && source ${wsl.repo_path}/install/setup.bash && ../../.venv/bin/python -m app.main > /tmp/launcher_backend.log 2>&1",
    "frontend_cmd": "cd web_gui/frontend && npm run dev > /tmp/launcher_frontend.log 2>&1",
    "stop_cmd": "pkill -f 'app.main' ; pkill -f 'npm run dev' ; true",
    "ready_timeout_sec": 60
  },

  "devices": {
    "headband": {
      "label": "Headband",
      "type": "bridge",
      "command": "python gpype_lsl_bridge.py",
      "cwd": "${sync.dst_root}\\gtec_bridge",
      "verify_delay_sec": 5,
      "verify_cmd": null
    },
    "hybrid": {
      "label": "HybridBlack",
      "type": "bridge",
      "command": "python unicornpy_lsl_bridge.py",
      "cwd": "${sync.dst_root}\\gtec_bridge",
      "verify_delay_sec": 5,
      "verify_cmd": null
    },
    "thymio": {
      "label": "Thymio",
      "type": "usbipd",
      "attach_cmd": "usbipd attach --wsl=Ubuntu --busid=1-1",
      "detach_cmd": "usbipd detach --busid=1-1",
      "verify_cmd": "wsl -d Ubuntu -e bash -lc \"test -e /dev/ttyACM0 && echo ok\"",
      "verify_delay_sec": 3
    }
  },

  "sidebar": {
    "groups": [
      {
        "id": "system",
        "label": "系统状态",
        "items": [{"id": "system-state", "type": "status", "label": "系统状态"}]
      },
      {
        "id": "devices",
        "label": "设备连接",
        "items": [
          {"id": "headband", "type": "device", "label": "Headband"},
          {"id": "hybrid", "type": "device", "label": "HybridBlack"},
          {"id": "thymio", "type": "device", "label": "Thymio"}
        ]
      },
      {
        "id": "ops",
        "label": "系统操作",
        "items": [
          {"id": "start-system", "type": "action", "label": "启动系统"},
          {"id": "restart-web", "type": "action", "label": "重启 web 服务"},
          {"id": "stop-system", "type": "action", "label": "关闭系统"}
        ]
      }
    ],
    "log": {"id": "view-log", "type": "action", "label": "查看日志", "placeholder": true}
  }
}
